# ============================================================================
# WRISTORA ADMIN API — standalone backend for the admin panel.
# Completely independent of the storefront server: its own port, its own secrets.
# The ONLY thing shared with the storefront is MONGODB_URI (the common database).
# ============================================================================

# ---- Core ----
NODE_ENV=development
# Admin API runs on its own port (the storefront server uses 8000).
PORT=8001

# ---- THE COMMON DATABASE (same database the customer website reads) ----
MONGODB_URI=mongodb+srv://raoankur2703_db_user:gW4a4friJA2nUdnr@cluster0.ipejicj.mongodb.net/?compressors=zlib

# ---- Admin-only secrets (independent from the storefront server) ----
